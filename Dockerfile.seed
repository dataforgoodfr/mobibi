# Runs `pnpm seed` once against a linked database, then exits. Deploy as a
# throwaway Dokku app on the same Postgres service — the main app's image
# (see Dockerfile) is pruned to the Next.js standalone output and has no
# source, pnpm, or the Payload CLI, so it can't run this directly.
FROM node:22-alpine AS base
RUN corepack enable

FROM base AS deps
RUN apk add --no-cache libc6-compat
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN --mount=type=cache,id=pnpm,target=/root/.local/share/pnpm/store \
  pnpm install --frozen-lockfile

FROM base AS seed
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .
ENV NODE_ENV=production
CMD ["pnpm", "seed"]
