DATABASE_URL=postgres://127.0.0.1:5432/your-database-name
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Absolute origin used to build links in emails (magic links, …). Same env var
# @payloadcms/next itself falls back to for metadataBase.
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000

# Integration tests run against this database instead of DATABASE_URL.
DATABASE_URL_TEST=postgres://127.0.0.1:5432/your-database-name_test

# Optional. Leave unset for local dev, emails log to the console instead.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM_ADDRESS=no-reply@mobibi.fr
# SMTP_FROM_NAME=mobibi

# How campaigners log in: oidc | magic-link. One method per installation.
# Unset: campaigner accounts are disabled (only platform admins exist).
# magic-link is not implemented yet: the app refuses to start with it.
# The values below match the local Keycloak of « Plateforme pour la démocratie »
# (`pnpm keycloak:up` in that repo, seeded client `mobibi`).
CAMPAIGNER_AUTH_METHOD=oidc

OIDC_ISSUER=http://localhost:8180/realms/democratie
OIDC_CLIENT_ID=mobibi
OIDC_CLIENT_SECRET=dev-mobibi-secret
# Optional. Client role required to use mobibi, checked at login and on every token
# refresh. Read from `resource_access.<OIDC_CLIENT_ID>.roles` (Keycloak's layout).
OIDC_REQUIRED_ROLE=access
